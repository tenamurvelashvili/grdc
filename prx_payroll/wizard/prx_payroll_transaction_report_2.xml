<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_prx_payroll_transaction_report_2_form" model="ir.ui.view">
            <field name="name">prx.payroll.transaction.report.2.form</field>
            <field name="model">prx.payroll.transaction.report.2</field>
            <field name="arch" type="xml">
                <form string="ტრანზაქციების გამარტივებული რეპორტი">
                    <sheet>
                        <group>
                            <field name="period_ids" widget="many2many_tags"/>
                            <field name="salary_type_filter" widget="radio"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_download" filename="file_name" widget="download"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="გენერაცია" type="object" name="generate_report"
                                class="btn-primary"/>
                        <button string="გაუქმება" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

