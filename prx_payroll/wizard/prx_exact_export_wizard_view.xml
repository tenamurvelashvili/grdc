<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prx_exact_export_wizard_form" model="ir.ui.view">
        <field name="name">prx.exact.export.wizard.form</field>
        <field name="model">prx.exact.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export to Exact">
                <group>
                    <field name="period_id"/>
                    <field name="dagbknr"/>
                </group>
                <footer>
                    <button name="action_export" string="Export" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_prx_exact_export_wizard" model="ir.actions.act_window">
        <field name="name">Export to Exact</field>
        <field name="res_model">prx.exact.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_prx_exact_export"
              name="Exact Export"
              parent="prx_payroll.prx_payroll_menu_report_root"
              action="action_prx_exact_export_wizard"
              sequence="100"/>
</odoo>
