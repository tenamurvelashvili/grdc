<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="update_nbg_currencies_rate" model="ir.cron">
            <field name="name">Update NBG currencies rate</field>
            <field name="model_id" ref="model_res_currency"/>
            <field name="state">code</field>
            <field name="code">model.update_currency_rates_nbg()</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>
